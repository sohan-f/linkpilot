<?xml version="1.0" encoding="utf-8"?>
<!-- Assembles the filled devices glyph from its parts when the tab becomes selected. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_devices_states">
    <target android:name="outline">
        <aapt:attr name="android:animation">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="1"
                    android:valueTo="0"
                    android:duration="260"
                    android:startOffset="0"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="g_stand">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.06"
                        android:valueTo="1"
                        android:duration="260"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.6"
                        android:valueTo="1"
                        android:duration="260"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_stand">
        <aapt:attr name="android:animation">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="80"
                    android:startOffset="0"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_screen">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="-140"
                        android:valueTo="0"
                        android:duration="330"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="1.06"
                        android:valueTo="1"
                        android:duration="330"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.84"
                        android:valueTo="1"
                        android:duration="330"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_monitor">
        <aapt:attr name="android:animation">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="110"
                    android:startOffset="80"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="p_phone">
        <aapt:attr name="android:animation">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="110"
                    android:startOffset="80"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
