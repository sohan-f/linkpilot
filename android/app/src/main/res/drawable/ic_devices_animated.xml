<?xml version="1.0" encoding="utf-8"?>
<!-- Assembles the filled devices glyph from its parts when the tab becomes selected. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_devices_states">
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_stand">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.15"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_stand">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="110"
                android:startOffset="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_monitor">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="-75"
                        android:valueTo="0"
                        android:duration="250"
                        android:startOffset="30"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.90"
                        android:valueTo="1"
                        android:duration="250"
                        android:startOffset="30"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_monitor">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="120"
                android:startOffset="30"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_phone">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateX"
                        android:valueFrom="120"
                        android:valueTo="0"
                        android:duration="270"
                        android:startOffset="55"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.68"
                        android:valueTo="1"
                        android:duration="270"
                        android:startOffset="55"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.68"
                        android:valueTo="1"
                        android:duration="270"
                        android:startOffset="55"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="rotation"
                        android:valueFrom="11"
                        android:valueTo="0"
                        android:duration="270"
                        android:startOffset="55"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_phone">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="120"
                android:startOffset="90"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_camera">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.08"
                        android:valueTo="1"
                        android:duration="190"
                        android:startOffset="200"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.08"
                        android:valueTo="1"
                        android:duration="190"
                        android:startOffset="200"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_camera">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="100"
                android:startOffset="200"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
