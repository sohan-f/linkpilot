<?xml version="1.0" encoding="utf-8"?>
<!-- Plots the insights chart: the centreline draws left to right and each node lands as the pen
     reaches it, then the sparkles spin in over the finished chart. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_insights_states">
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0"
                android:duration="240"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="trace">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="300"
                android:startOffset="20"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="g_node1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="20"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="20"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="26"
                    android:valueTo="0"
                    android:duration="200"
                    android:startOffset="20"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_node1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="70"
                android:startOffset="20"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_node2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="145"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="145"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="26"
                    android:valueTo="0"
                    android:duration="200"
                    android:startOffset="145"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_node2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="70"
                android:startOffset="145"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_node3">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="220"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="200"
                    android:startOffset="220"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="26"
                    android:valueTo="0"
                    android:duration="200"
                    android:startOffset="220"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_node3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="70"
                android:startOffset="220"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_node4">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="210"
                    android:startOffset="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.18"
                    android:valueTo="1"
                    android:duration="210"
                    android:startOffset="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="26"
                    android:valueTo="0"
                    android:duration="210"
                    android:startOffset="300"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_node4">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="70"
                android:startOffset="300"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_spark_small">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.10"
                    android:valueTo="1"
                    android:duration="240"
                    android:startOffset="240"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.10"
                    android:valueTo="1"
                    android:duration="240"
                    android:startOffset="240"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="150"
                    android:valueTo="0"
                    android:duration="240"
                    android:startOffset="240"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_spark_small">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="90"
                android:startOffset="240"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_spark_big">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.10"
                    android:valueTo="1"
                    android:duration="280"
                    android:startOffset="285"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.10"
                    android:valueTo="1"
                    android:duration="280"
                    android:startOffset="285"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-180"
                    android:valueTo="0"
                    android:duration="280"
                    android:startOffset="285"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_spark_big">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="90"
                android:startOffset="285"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
