<?xml version="1.0" encoding="utf-8"?>
<!-- Assembles the filled wifi glyph from its parts when the tab becomes selected. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_wifi_states">
    <target android:name="g_dot">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="220"
                    android:startOffset="0">
                    <propertyValuesHolder
                        android:propertyName="scaleX"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.34"
                        android:value="1.26"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="220"
                    android:startOffset="0">
                    <propertyValuesHolder
                        android:propertyName="scaleY"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.34"
                        android:value="1.26"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="g_wave1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="280"
                    android:startOffset="55">
                    <propertyValuesHolder
                        android:propertyName="translateY"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="-34"
                        android:interpolator="@android:interpolator/accelerate_decelerate" />
                    <keyframe
                        android:fraction="1"
                        android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="280"
                    android:startOffset="55">
                    <propertyValuesHolder
                        android:propertyName="scaleX"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="1.1"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="280"
                    android:startOffset="55">
                    <propertyValuesHolder
                        android:propertyName="scaleY"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="1.1"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
    <target android:name="g_wave2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="300"
                    android:startOffset="110">
                    <propertyValuesHolder
                        android:propertyName="translateY"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="-72"
                        android:interpolator="@android:interpolator/accelerate_decelerate" />
                    <keyframe
                        android:fraction="1"
                        android:value="0" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="300"
                    android:startOffset="110">
                    <propertyValuesHolder
                        android:propertyName="scaleX"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="1.05"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator
                    android:duration="300"
                    android:startOffset="110">
                    <propertyValuesHolder
                        android:propertyName="scaleY"
                        android:valueType="floatType">
                    <keyframe
                        android:fraction="0"
                        android:value="1"
                        android:interpolator="@android:interpolator/overshoot" />
                    <keyframe
                        android:fraction="0.4"
                        android:value="1.05"
                        android:interpolator="@android:interpolator/fast_out_slow_in" />
                    <keyframe
                        android:fraction="1"
                        android:value="1" />
                    </propertyValuesHolder>
                </objectAnimator>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
