<?xml version="1.0" encoding="utf-8"?>
<!-- Assembles the filled wifi glyph from its parts when the tab becomes selected. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_wifi_states">
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_dot">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.12"
                        android:valueTo="1"
                        android:duration="210"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.12"
                        android:valueTo="1"
                        android:duration="210"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_dot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="100"
                android:startOffset="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_wave1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="30"
                        android:valueTo="0"
                        android:duration="250"
                        android:startOffset="30"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.62"
                        android:valueTo="1"
                        android:duration="250"
                        android:startOffset="30"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.62"
                        android:valueTo="1"
                        android:duration="250"
                        android:startOffset="30"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_wave1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="120"
                android:startOffset="35"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_wave2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="60"
                        android:valueTo="0"
                        android:duration="290"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.42"
                        android:valueTo="1"
                        android:duration="290"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.42"
                        android:valueTo="1"
                        android:duration="290"
                        android:startOffset="80"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_wave2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="140"
                android:startOffset="75"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
