<?xml version="1.0" encoding="utf-8"?>
<!-- Assembles the filled more_horiz glyph from its parts when the tab becomes selected. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_more_horiz_states">
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_dot1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="65"
                        android:valueTo="0"
                        android:duration="230"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="0"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_dot1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="100"
                android:startOffset="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_dot2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="65"
                        android:valueTo="0"
                        android:duration="230"
                        android:startOffset="50"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="50"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="50"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_dot2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="100"
                        android:startOffset="50"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="g_dot3">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                    <objectAnimator
                        android:propertyName="translateY"
                        android:valueFrom="65"
                        android:valueTo="0"
                        android:duration="230"
                        android:startOffset="100"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleX"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="100"
                        android:interpolator="@android:interpolator/overshoot" />
                    <objectAnimator
                        android:propertyName="scaleY"
                        android:valueFrom="0.28"
                        android:valueTo="1"
                        android:duration="230"
                        android:startOffset="100"
                        android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="p_dot3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="100"
                android:startOffset="100"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
